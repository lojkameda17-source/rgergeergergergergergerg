# ╔══════════════════════════════════════╗
# ║      Lead Monitor — конфигурация      ║
# ╚══════════════════════════════════════╝

# Токен Telegram бота (получи у @BotFather)
BOT_TOKEN=

# Твой Telegram ID (узнай у @userinfobot)
ADMIN_IDS=

# Данные приложения Telegram → my.telegram.org → Apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Groq API ключ → console.groq.com (бесплатно)
GROQ_API_KEY=

# Модель (не меняй без надобности)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# База данных (SQLite для локального запуска)
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Включить мониторинг (true/false)
MONITOR_ENABLED=true
